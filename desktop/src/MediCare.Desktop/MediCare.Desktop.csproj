<Project Sdk="Microsoft.NET.Sdk">

  <!-- MediCare Practice — WPF desktop application (BRD §6: C# + WPF + SQLite). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MediCare.Desktop</RootNamespace>
    <AssemblyName>MediCare</AssemblyName>
    <ApplicationIcon>Assets\medicare.ico</ApplicationIcon>
    <Product>MediCare Practice</Product>
    <Company>MediCare Practice</Company>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediCare.Core\MediCare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\medicare.ico" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
