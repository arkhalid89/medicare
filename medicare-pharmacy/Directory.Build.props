<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Company>MediCare Pharmacy</Company>
    <Product>MediCare Pharmacy</Product>
    <Copyright>MediCare Pharmacy</Copyright>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591;NETSDK1138;CA1416</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
