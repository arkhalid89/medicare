<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MediCare.Host</RootNamespace>
    <AssemblyName>MediCare.Host</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>medicare-pharmacy-host</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="MiniExcel" Version="1.44.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sql\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MediCare.Contracts\MediCare.Contracts.csproj" />
    <ProjectReference Include="..\MediCare.Core\MediCare.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MediCare.Host.Tests" />
  </ItemGroup>
</Project>
